{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meraki-santier",
  "main": "dist/worker.js",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
