{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meraki-santier",
  "main": "src/worker.js",
  "compatibility_date": "2025-04-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
